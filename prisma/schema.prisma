generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SELLER
  FINANCE
  SUPPORT
  VIEWER
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  DISABLED
}

enum ClientDocumentType {
  CPF
  CNPJ
}

enum SaleStage {
  QUOTE
  ORDER
  PAID
}

enum SalesChannel {
  WHATSAPP
  SITE
  PHYSICAL_STORE
}

enum PaymentMethod {
  CARD
  PIX
  BOLETO
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PAID
}

enum SupportKind {
  ATTENDANCE
  AFTER_SALES
  COMPLAINT
  SAC
}

enum DeliveryMethod {
  PICKUP
  CORREIOS
  CARRIER
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  status       OrganizationStatus @default(ACTIVE)
  settings     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships           Membership[]
  auditLogs             AuditLog[]
  integrations          Integration[]
  activeSessions        Session[]
  clients               Client[]
  clientAddresses       ClientAddress[]
  clientSegments        ClientSegment[]
  clientCreditAccounts  ClientCreditAccount[]
  clientCreditMovements ClientCreditMovement[]
  clientValeAccounts    ClientValeAccount[]
  clientValeMovements   ClientValeMovement[]
  clientCrmEntries      ClientCrmEntry[]
  clientModuleSettings  ClientModuleSettings?
  productCategories     ProductCategory[]
  products              Product[]
  productPhotos         ProductPhoto[]
  productStocks         ProductStock[]
  catalogShare          CatalogShare?
  sales                 Sale[]
  saleItems             SaleItem[]
  salePayments          SalePayment[]
  supportRecords        SupportRecord[]
  saleDeliveries        SaleDelivery[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships            Membership[]
  auditLogs              AuditLog[]
  sessions               Session[]
  creditMovementsCreated ClientCreditMovement[] @relation("CreditMovementCreator")
  valeMovementsCreated   ClientValeMovement[]   @relation("ValeMovementCreator")
  crmEntriesCreated      ClientCrmEntry[]        @relation("CrmEntryCreator")
  supportRecordsCreated  SupportRecord[]         @relation("SupportRecordCreator")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibleClients Client[]     @relation("ClientResponsibleSeller")
  assignedSales      Sale[]       @relation("SaleSeller")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  activeOrganizationId String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  lastSeenAt           DateTime @default(now())

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization @relation(fields: [activeOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([activeOrganizationId, expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  key            String
  displayName    String
  status         IntegrationStatus @default(DISCONNECTED)
  settings       Json?
  secretRef      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, key])
  @@index([organizationId, provider])
}

model Client {
  id                            String             @id @default(cuid())
  organizationId                String
  segmentId                     String?
  responsibleSellerMembershipId String?
  name                          String
  documentType                  ClientDocumentType
  document                      String
  whatsapp                      String
  email                         String
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segment            ClientSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  responsibleSeller  Membership?    @relation("ClientResponsibleSeller", fields: [responsibleSellerMembershipId], references: [id], onDelete: SetNull)
  address            ClientAddress?
  creditAccount      ClientCreditAccount?
  creditMovements    ClientCreditMovement[]
  valeAccount        ClientValeAccount?
  valeMovements      ClientValeMovement[]
  crmEntries         ClientCrmEntry[]
  sales              Sale[]
  supportRecords     SupportRecord[]

  @@unique([organizationId, document])
  @@index([organizationId, name])
  @@index([organizationId, whatsapp])
  @@index([organizationId, email])
  @@index([organizationId, segmentId])
  @@index([organizationId, responsibleSellerMembershipId])
}

model ClientAddress {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String   @unique
  postalCode     String
  street         String
  number         String
  complement     String?
  district       String
  city           String
  state          String
  country        String   @default("BR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, city, state])
  @@index([organizationId, postalCode])
}

model ClientSegment {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients      Client[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model ClientCreditAccount {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String   @unique
  creditLimit    Decimal  @default(0) @db.Decimal(14, 2)
  usedAmount     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  movements    ClientCreditMovement[]

  @@index([organizationId, clientId])
}

model ClientCreditMovement {
  id              String   @id @default(cuid())
  organizationId  String
  clientId        String
  accountId       String
  amountDelta     Decimal  @db.Decimal(14, 2)
  usedBefore      Decimal  @db.Decimal(14, 2)
  usedAfter       Decimal  @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      ClientCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("CreditMovementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, accountId, createdAt])
}

model ClientValeAccount {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String   @unique
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  movements    ClientValeMovement[]

  @@index([organizationId, clientId])
}

model ClientValeMovement {
  id              String   @id @default(cuid())
  organizationId  String
  clientId        String
  accountId       String
  amountDelta     Decimal  @db.Decimal(14, 2)
  balanceBefore   Decimal  @db.Decimal(14, 2)
  balanceAfter    Decimal  @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account      ClientValeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ValeMovementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, accountId, createdAt])
}

model ClientCrmEntry {
  id              String   @id @default(cuid())
  organizationId  String
  clientId        String
  title           String
  content         String
  occurredAt      DateTime @default(now())
  followUpAt      DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CrmEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, occurredAt])
  @@index([organizationId, followUpAt])
}

model ClientModuleSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  inactivityDays Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         ProductCategory[] @relation("CategoryTree")
  products         Product[]         @relation("ProductCategory")
  subcategoryItems Product[]         @relation("ProductSubcategory")

  @@unique([organizationId, parentId, name])
  @@index([organizationId, parentId, name])
}

model Product {
  id                  String   @id @default(cuid())
  organizationId      String
  categoryId          String
  subcategoryId       String?
  name                String
  sku                 String
  barcode             String?
  brandManufacturer   String
  description         String
  technicalAttributes Json?
  costPrice           Decimal  @db.Decimal(14, 2)
  salePrice           Decimal  @db.Decimal(14, 2)
  unitMeasure         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory  @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory  ProductCategory? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  photos       ProductPhoto[]
  stock        ProductStock?
  saleItems    SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([organizationId, categoryId])
  @@index([organizationId, subcategoryId])
}

model ProductPhoto {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  url            String
  variation      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId])
  @@index([organizationId, productId, variation])
}

model ProductStock {
  id             String   @id @default(cuid())
  organizationId String
  productId      String   @unique
  quantity       Decimal  @default(0) @db.Decimal(14, 3)
  minimum        Decimal  @default(0) @db.Decimal(14, 3)
  maximum        Decimal  @default(0) @db.Decimal(14, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId])
  @@index([organizationId, quantity])
}

model CatalogShare {
  id             String   @id @default(cuid())
  organizationId String   @unique
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Sale {
  id                 String       @id @default(cuid())
  organizationId     String
  clientId           String
  sellerMembershipId String
  stage              SaleStage    @default(QUOTE)
  channel            SalesChannel
  totalAmount        Decimal      @default(0) @db.Decimal(14, 2)
  quotedAt           DateTime     @default(now())
  orderedAt          DateTime?
  paidAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  seller         Membership      @relation("SaleSeller", fields: [sellerMembershipId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       SalePayment[]
  supportRecords SupportRecord[]
  delivery       SaleDelivery?

  @@index([organizationId, stage, createdAt])
  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, sellerMembershipId, createdAt])
  @@index([organizationId, channel, createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  organizationId String
  saleId         String
  productId      String
  productName    String
  sku            String
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, saleId])
  @@index([organizationId, productId, createdAt])
}

model SalePayment {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  dueDate        DateTime?
  settledAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId, saleId, createdAt])
  @@index([organizationId, method, createdAt])
  @@index([organizationId, status, dueDate])
}

model SupportRecord {
  id              String      @id @default(cuid())
  organizationId  String
  clientId        String
  saleId          String?
  kind            SupportKind
  content         String
  createdByUserId String
  createdAt       DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("SupportRecordCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, saleId, createdAt])
  @@index([organizationId, kind, createdAt])
}

model SaleDelivery {
  id                String         @id @default(cuid())
  organizationId    String
  saleId            String         @unique
  method            DeliveryMethod
  pickupRegisteredAt DateTime?
  trackingCode      String?
  carrierName       String?
  shipmentProofUrl  String?
  deliveryProofUrl  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId, method, createdAt])
  @@index([organizationId, trackingCode])
}
