# Copie para .env.production no servidor e substitua todos os valores de exemplo.
# Este arquivo não deve conter credenciais reais no Git.

APP_URL="https://erp.exemplo.com"
APP_PORT="3000"
STORAGE_ROOT="/app/storage"
MAX_UPLOAD_BYTES="26214400"
FILE_TOKEN_SECRET="troque-por-um-segredo-forte-com-pelo-menos-32-caracteres"

POSTGRES_USER="erp"
POSTGRES_PASSWORD="troque-por-senha-forte"
POSTGRES_DB="erp_pedro"
DATABASE_URL="postgresql://erp:troque-por-senha-forte@postgres:5432/erp_pedro?schema=public"

# Use apenas para o primeiro bootstrap de uma instalação vazia quando necessário.
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD="troque-por-senha-forte"
SEED_ORG_NAME="Pedro"
SEED_ORG_SLUG="pedro"
